-- ============================================================
-- DATABASE: GYM MANAGEMENT (SIMPLIFIED - 5-6 TUẦN)
-- Phù hợp cho nhóm 3 coder, ưu tiên chức năng cốt lõi
-- ============================================================

CREATE DATABASE IF NOT EXISTS gym_management
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE gym_management;

-- ============================================================
-- USERS - Tài khoản người dùng
-- ============================================================
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    phone VARCHAR(20) NOT NULL,
    password VARCHAR(255) NOT NULL COMMENT 'Mật khẩu đã mã hóa (bcrypt)',
    role ENUM('user', 'staff', 'admin', 'trainer') DEFAULT 'user',
    avatar_url VARCHAR(255) NULL,
    is_active TINYINT(1) DEFAULT 1,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- ============================================================
-- TRAINERS - Hồ sơ huấn luyện viên
-- Giữ tối giản: chỉ chuyên môn + trạng thái nhận học viên
-- Thông tin chi tiết (bio, kinh nghiệm) có thể thêm sau
-- ============================================================
CREATE TABLE trainers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL UNIQUE,
    specialization ENUM('gym', 'yoga', 'both') NOT NULL COMMENT 'Chuyên môn: thể hình / yoga / cả hai',
    is_available TINYINT(1) DEFAULT 1 COMMENT 'Đang nhận học viên',
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

-- ============================================================
-- MEMBERSHIPS - Gói tập
-- Phân loại rõ: gym hoặc yoga, giá cố định không giảm giá
-- ============================================================
CREATE TABLE memberships (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL COMMENT 'Tên gói (VD: Gym Cơ Bản, Yoga 1 Tháng)',
    category ENUM('gym', 'yoga') NOT NULL COMMENT 'Loại gói: thể hình hoặc yoga',
    description TEXT NULL,
    duration_days INT NOT NULL COMMENT 'Số ngày hiệu lực',
    price DECIMAL(12,2) NOT NULL COMMENT 'Giá cố định',
    allow_pt TINYINT(1) DEFAULT 0 COMMENT 'Gói có kèm PT không',
    pt_sessions INT DEFAULT 0 COMMENT 'Số buổi PT đi kèm (nếu có)',
    is_active TINYINT(1) DEFAULT 1,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- SUBSCRIPTIONS - Đăng ký gói tập của người dùng
-- ============================================================
CREATE TABLE subscriptions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    membership_id INT NOT NULL,
    trainer_id INT NULL COMMENT 'PT được phân công (nếu gói có PT)',
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    final_price DECIMAL(12,2) NOT NULL COMMENT 'Giá thực tế khi đăng ký',
    pt_sessions_left INT DEFAULT 0 COMMENT 'Số buổi PT còn lại',
    status ENUM('pending_payment', 'active', 'expired', 'cancelled') DEFAULT 'pending_payment',
    cancel_reason TEXT NULL,
    cancelled_at DATETIME NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (membership_id) REFERENCES memberships(id),
    FOREIGN KEY (trainer_id) REFERENCES trainers(id)
);

-- ============================================================
-- PAYMENTS - Thanh toán
-- ============================================================
CREATE TABLE payments (
    id INT AUTO_INCREMENT PRIMARY KEY,
    subscription_id INT NOT NULL,
    amount DECIMAL(12,2) NOT NULL,
    method ENUM('cash', 'transfer', 'e_wallet') NOT NULL,
    status ENUM('pending', 'completed', 'refunded') DEFAULT 'pending',
    invoice_code VARCHAR(100) NULL COMMENT 'Mã hóa đơn tự sinh',
    note TEXT NULL,
    confirmed_by INT NULL COMMENT 'Nhân viên xác nhận (thanh toán tiền mặt)',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (subscription_id) REFERENCES subscriptions(id),
    FOREIGN KEY (confirmed_by) REFERENCES users(id)
);

-- ============================================================
-- SCHEDULES - Lịch lớp học (gym hoặc yoga)
-- ============================================================
CREATE TABLE schedules (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200) NOT NULL COMMENT 'Tên lớp (VD: Yoga buổi sáng, Cardio tổng hợp)',
    category ENUM('gym', 'yoga') NOT NULL COMMENT 'Loại lớp',
    trainer_id INT NULL,
    start_time DATETIME NOT NULL,
    end_time DATETIME NOT NULL,
    capacity INT DEFAULT 20,
    current_enrolled INT DEFAULT 0,
    status ENUM('upcoming', 'ongoing', 'completed', 'cancelled') DEFAULT 'upcoming',
    FOREIGN KEY (trainer_id) REFERENCES trainers(id)
);

-- ============================================================
-- BOOKINGS - Đặt lịch lớp học hoặc buổi PT 1-1
-- ============================================================
CREATE TABLE bookings (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    subscription_id INT NOT NULL,
    booking_type ENUM('class', 'pt_session') NOT NULL,
    schedule_id INT NULL COMMENT 'Lịch lớp (nếu booking_type = class)',
    trainer_id INT NULL COMMENT 'PT 1-1 (nếu booking_type = pt_session)',
    start_time DATETIME NOT NULL,
    end_time DATETIME NOT NULL,
    status ENUM('confirmed', 'cancelled', 'completed') DEFAULT 'confirmed',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (subscription_id) REFERENCES subscriptions(id),
    FOREIGN KEY (schedule_id) REFERENCES schedules(id),
    FOREIGN KEY (trainer_id) REFERENCES trainers(id)
);

-- ============================================================
-- CHECKINS - Check-in bằng QR
-- ============================================================
CREATE TABLE checkins (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    subscription_id INT NOT NULL,
    qr_token VARCHAR(255) NOT NULL UNIQUE COMMENT 'Token QR động (UUID hoặc JWT ngắn hạn)',
    expires_at DATETIME NOT NULL,
    checked_in_at DATETIME NULL,
    status ENUM('active', 'used', 'expired') DEFAULT 'active',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (subscription_id) REFERENCES subscriptions(id)
);

-- ============================================================
-- EQUIPMENTS - Quản lý thiết bị phòng tập
-- ============================================================
CREATE TABLE equipments (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    description TEXT NULL,
    status ENUM('active', 'maintenance', 'broken') DEFAULT 'active',
    last_maintained_at DATE NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- REVIEWS - Đánh giá PT
-- ============================================================
CREATE TABLE reviews (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    trainer_id INT NOT NULL,
    booking_id INT NULL COMMENT 'Ràng buộc: chỉ review sau buổi tập thực tế',
    rating INT NOT NULL COMMENT '1-5 sao',
    comment TEXT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (trainer_id) REFERENCES trainers(id),
    FOREIGN KEY (booking_id) REFERENCES bookings(id)
);

-- ============================================================
-- NOTIFICATIONS - Thông báo hệ thống
-- ============================================================
CREATE TABLE notifications (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    type ENUM('system', 'reminder', 'booking', 'payment') DEFAULT 'system',
    is_read TINYINT(1) DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- ============================================================
-- NEWS - Tin tức / Sự kiện
-- ============================================================
CREATE TABLE news (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    content LONGTEXT NOT NULL,
    thumbnail_url VARCHAR(255) NULL,
    author_id INT NOT NULL COMMENT 'Staff hoặc Admin',
    category ENUM('news', 'event', 'announcement') DEFAULT 'news',
    status ENUM('draft', 'published', 'archived') DEFAULT 'draft',
    published_at DATETIME NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (author_id) REFERENCES users(id)
);

-- ============================================================
-- SUPPORT TICKETS - Hỗ trợ khách hàng
-- ============================================================
CREATE TABLE support_tickets (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    subject VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    reply TEXT NULL,
    assigned_to INT NULL COMMENT 'Nhân viên xử lý',
    status ENUM('open', 'in_progress', 'closed') DEFAULT 'open',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (assigned_to) REFERENCES users(id)
);
